@model MvcCrudApp.Models.Employee

@{
    ViewData["Title"] = $"Delete - {Model?.Name}";
}

<h1>Delete Employee</h1>

<div role="alert" class="alert alert-warning">
    <h2 class="h4" id="delete-confirmation-heading">Are you sure you want to delete this employee?</h2>
    <p class="mb-0">This action cannot be undone.</p>
</div>

<div>
    <h3 class="h5">Employee Information</h3>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Department)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Department)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Position)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Position)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div role="group" aria-label="Delete confirmation actions">
            <button type="submit" 
                    class="btn btn-danger" 
                    aria-describedby="delete-confirmation-heading"
                    aria-label="Confirm delete @Model?.Name">
                Delete Employee
            </button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
