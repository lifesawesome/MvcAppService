@model MvcCrudApp.Models.Employee

@{
    ViewData["Title"] = "Create Employee";
}

<h1>Create New Employee</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" aria-live="polite"></div>
            <fieldset>
                <legend class="sr-only">Employee Information</legend>
                <p class="text-muted" id="form-instructions">
                    <small>All fields marked with <span class="text-danger" aria-label="required">*</span> are required.</small>
                </p>
                <div class="form-group mb-3">
                    <label asp-for="Name" class="control-label">
                        @Html.DisplayNameFor(model => model.Name)
                        <span class="text-danger" aria-label="required">*</span>
                    </label>
                    <input asp-for="Name" class="form-control" aria-required="true" aria-describedby="Name-error" />
                    <span asp-validation-for="Name" class="text-danger" id="Name-error" role="alert"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Department" class="control-label">
                        @Html.DisplayNameFor(model => model.Department)
                        <span class="text-danger" aria-label="required">*</span>
                    </label>
                    <input asp-for="Department" class="form-control" aria-required="true" aria-describedby="Department-error" />
                    <span asp-validation-for="Department" class="text-danger" id="Department-error" role="alert"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Position" class="control-label">
                        @Html.DisplayNameFor(model => model.Position)
                        <span class="text-danger" aria-label="required">*</span>
                    </label>
                    <input asp-for="Position" class="form-control" aria-required="true" aria-describedby="Position-error" />
                    <span asp-validation-for="Position" class="text-danger" id="Position-error" role="alert"></span>
                </div>
                <div class="form-group" role="group" aria-label="Form actions">
                    <button type="submit" class="btn btn-primary">Create Employee</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </fieldset>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}