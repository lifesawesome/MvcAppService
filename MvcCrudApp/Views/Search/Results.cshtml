@model IEnumerable<MvcCrudApp.Models.Employee>

@{
    ViewData["Title"] = "Search Results";
    var searchTerm = ViewData["SearchTerm"] as string;
}

<h1>Search Results</h1>

<div class="mb-3">
    <p class="lead">
        @if (Model.Any())
        {
            <span>Found <strong>@Model.Count()</strong> result@(Model.Count() == 1 ? "" : "s") for "<strong>@searchTerm</strong>"</span>
        }
        else
        {
            <span>No results found for "<strong>@searchTerm</strong>"</span>
        }
    </p>
    <a asp-action="Index" class="btn btn-primary">New Search</a>
    <a asp-controller="Employee" asp-action="Index" class="btn btn-secondary">All Employees</a>
</div>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover" role="table" aria-label="Search results table">
            <thead>
                <tr>
                    <th scope="col">
                        @Html.DisplayNameFor(model => model.Name)
                    </th>
                    <th scope="col">
                        @Html.DisplayNameFor(model => model.Department)
                    </th>
                    <th scope="col">
                        @Html.DisplayNameFor(model => model.Position)
                    </th>
                    <th scope="col">
                        <span class="visually-hidden">Actions</span>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Name)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Department)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Position)
                        </td>
                        <td>
                            <a asp-controller="Employee" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info" aria-label="View details for @item.Name">Details</a>
                            <a asp-controller="Employee" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" aria-label="Edit @item.Name">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info" role="alert">
        <h4 class="alert-heading">No results found</h4>
        <p>Try searching with different terms or check the spelling.</p>
        <hr>
        <p class="mb-0">
            <a asp-action="Index" class="alert-link">Perform another search</a> or 
            <a asp-controller="Employee" asp-action="Index" class="alert-link">view all employees</a>.
        </p>
    </div>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
